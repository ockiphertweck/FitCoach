# Database — keep the password in DATABASE_URL in sync with DB_PASSWORD.
# localhost works for `pnpm dev` on the host; the Docker api container overrides
# DATABASE_URL to use the `postgres` service (see docker-compose.yml).
# Use letters and digits only (it is embedded in a URL), e.g. `openssl rand -hex 16`
DB_PASSWORD=changeme
DATABASE_URL=postgresql://fitcoach:changeme@localhost:5432/fitcoach

# Auth — generate with: openssl rand -base64 32
JWT_SECRET=
API_KEY_ENCRYPTION_KEY=

# Dev only: read by `pnpm --filter api garmin:probe`. The app does NOT use it —
# connect Garmin in Settings instead.
GARMIN_API_KEY=

# Claude API — optional at start, enter via Settings UI after setup
CLAUDE_API_KEY=

# PostHog — free at posthog.com, use EU region
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com


# Frontend URL (CORS origin)
FRONTEND_URL=http://localhost:3001

# API URL the browser calls. Baked into the frontend at build time; rebuild after changing.
# NEXT_PUBLIC_API_URL=http://localhost:3000
